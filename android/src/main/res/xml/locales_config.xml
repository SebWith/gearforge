<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-app language (localeConfig). Both languages shipped by the in-app EN/SV switch are
  listed so Android 13+ offers them under Settings > Apps > GearForge > Language.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="sv" />
</locale-config>
