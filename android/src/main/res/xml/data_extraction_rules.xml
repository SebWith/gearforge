<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and device-transfer rules for Android 12 (API 31) and higher.

  This file exists because `android:allowBackup="false"` is no longer the whole story on Android 12+:
  per https://developer.android.com/identity/data/autobackup (read 2026-09-20), on some manufacturers'
  devices it disables cloud backup but *not* device-to-device transfer, and a missing
  `<device-transfer>` section means that mode is "fully enabled for all content". The saved gear
  configurations live in shared preferences, and both the listing copy and PRIVACY_POLICY.md promise
  that designs are never uploaded — so both transfer modes are closed explicitly here rather than
  left to the default.

  Nothing in this app is worth restoring anyway: every value can be recreated from the parameters,
  and there is no account.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
